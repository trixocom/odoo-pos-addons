<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_trx_price_history" model="ir.ui.view">
        <field name="name">product.template.form.trx.price.history</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_trx_price_history" type="object" class="oe_stat_button" icon="fa-history"
                        invisible="trx_price_history_count == 0">
                    <field name="trx_price_history_count" widget="statinfo" string="Cambios de precio"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Historial de precios" name="trx_price_history">
                    <group>
                        <group>
                            <field name="trx_pvp_previous"/>
                            <field name="trx_pvp_previous_date"/>
                        </group>
                    </group>
                    <field name="trx_price_history_ids" readonly="1">
                        <list decoration-danger="variation_pct &gt; 0" decoration-success="variation_pct &lt; 0">
                            <field name="date"/>
                            <field name="price_type"/>
                            <field name="partner_id"/>
                            <field name="company_id" optional="hide"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="variation_pct" widget="percentage" digits="[16,2]"/>
                            <field name="origin"/>
                            <field name="origin_ref"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
