<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Estilos comunes (wkhtmltopdf: CSS simple, medidas en mm) -->
    <template id="price_label_style">
        <style>
            html, body { margin: 0 !important; padding: 0 !important; }
            .container, .container-fluid, main, .article { margin: 0 !important; padding: 0 !important; max-width: none !important; }
            table.trx-sheet, table.trx-sheet tr, table.trx-sheet td { border: 0 none !important; }
            .trx-pl { box-sizing: border-box; overflow: hidden; font-family: Arial, Helvetica, sans-serif; color: #000; position: relative; }
            .trx-pl .trx-pl-name { font-weight: bold; line-height: 1.12; overflow: hidden; }
            .trx-pl .trx-pl-row { width: 100%; }
            .trx-pl .trx-pl-code { float: left; }
            .trx-pl .trx-pl-price { float: right; font-weight: bold; line-height: 1; white-space: nowrap; }
            .trx-pl .trx-pl-psin { clear: both; white-space: nowrap; overflow: hidden; }
            .trx-pl .trx-pl-barcode { text-align: center; }
            .trx-pl .trx-pl-barcode img { display: block; margin: 0 auto; }
            .trx-pl .trx-pl-digits { text-align: center; letter-spacing: 0.4mm; }
        </style>
    </template>

    <!-- Cuerpo de una etiqueta. Medidas por variables para reusar en térmica y hoja. -->
    <template id="price_label_body">
        <div class="trx-pl" t-attf-style="width: {{w}}; height: {{h}}; padding: {{pad}};">
            <div class="trx-pl-name" t-attf-style="font-size: {{fs_name}}; height: {{name_h}};" t-out="label['name']"/>
            <div class="trx-pl-row" t-attf-style="height: {{price_h}};">
                <div class="trx-pl-code" t-attf-style="font-size: {{fs_small}}; padding-top: {{code_pt}};">
                    <t t-if="label['code']">Cód. <t t-out="label['code']"/></t>
                </div>
                <div class="trx-pl-price" t-attf-style="font-size: {{fs_price_long if label['price_long'] else fs_price}};" t-out="label['price']"/>
            </div>
            <div class="trx-pl-psin" t-attf-style="font-size: {{fs_psin}};">
                Precio sin impuestos nacionales: <t t-out="label['price_without_taxes']"/>
            </div>
            <div t-if="label['barcode']" class="trx-pl-barcode" t-attf-style="padding-top: {{bc_pt}};">
                <div t-out="label['barcode']" t-options="{'widget': 'barcode', 'quiet': 0, 'symbology': 'auto', 'img_style': bc_style}"/>
                <div class="trx-pl-digits" t-attf-style="font-size: {{fs_small}};" t-out="label['barcode']"/>
            </div>
        </div>
    </template>

    <!-- Térmica 50 x 25 mm: una etiqueta por página -->
    <template id="report_price_label_thermal_doc">
        <t t-call="web.html_container">
            <t t-set="w" t-value="'50mm'"/>
            <t t-set="h" t-value="'25mm'"/>
            <t t-set="pad" t-value="'1.2mm 1.8mm 0 1.8mm'"/>
            <t t-set="fs_name" t-value="'7.5pt'"/>
            <t t-set="name_h" t-value="'5.8mm'"/>
            <t t-set="price_h" t-value="'5.6mm'"/>
            <t t-set="fs_price" t-value="'14pt'"/>
            <t t-set="fs_price_long" t-value="'11pt'"/>
            <t t-set="fs_small" t-value="'5.5pt'"/>
            <t t-set="code_pt" t-value="'1.8mm'"/>
            <t t-set="fs_psin" t-value="'5pt'"/>
            <t t-set="bc_pt" t-value="'0.4mm'"/>
            <t t-set="bc_style" t-value="'width: 40mm; height: 6.2mm;'"/>
            <t t-foreach="labels" t-as="label">
                <!-- Cada .article es un cuerpo aparte para wkhtmltopdf (una página por etiqueta) -->
                <div class="article" style="width: 50mm; height: 25mm; overflow: hidden; margin: 0; padding: 0;">
                    <t t-call="trx_product_price_label.price_label_style"/>
                    <t t-call="trx_product_price_label.price_label_body"/>
                </div>
            </t>
        </t>
    </template>

    <!-- Hoja A4 3 x 8: 24 etiquetas de 70 x 37,1 mm -->
    <template id="report_price_label_sheet_doc">
        <t t-call="web.html_container">
            <t t-set="w" t-value="'70mm'"/>
            <t t-set="h" t-value="'37.1mm'"/>
            <t t-set="pad" t-value="'3mm 4mm 0 4mm'"/>
            <t t-set="fs_name" t-value="'10pt'"/>
            <t t-set="name_h" t-value="'7.6mm'"/>
            <t t-set="price_h" t-value="'8.2mm'"/>
            <t t-set="fs_price" t-value="'20pt'"/>
            <t t-set="fs_price_long" t-value="'15pt'"/>
            <t t-set="fs_small" t-value="'7pt'"/>
            <t t-set="code_pt" t-value="'3mm'"/>
            <t t-set="fs_psin" t-value="'6.5pt'"/>
            <t t-set="bc_pt" t-value="'1mm'"/>
            <t t-set="bc_style" t-value="'width: 52mm; height: 8.5mm;'"/>
            <t t-foreach="pages" t-as="page_labels">
                <div class="article" style="width: 210mm; height: 296mm; overflow: hidden; margin: 0; padding: 0;">
                    <t t-call="trx_product_price_label.price_label_style"/>
                    <table class="trx-sheet" style="border-collapse: collapse; table-layout: fixed; width: 210mm; border: 0 none;">
                        <t t-foreach="range(8)" t-as="row">
                            <tr>
                                <t t-foreach="range(3)" t-as="col">
                                    <t t-set="idx" t-value="row * 3 + col"/>
                                    <td style="width: 70mm; height: 37.1mm; padding: 0; vertical-align: top; border: 0 none;">
                                        <t t-if="idx &lt; len(page_labels)">
                                            <t t-set="label" t-value="page_labels[idx]"/>
                                            <t t-call="trx_product_price_label.price_label_body"/>
                                        </t>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
