<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_cash_move_wizard_form" model="ir.ui.view">
        <field name="name">pos.cash.move.wizard.form</field>
        <field name="model">pos.cash.move.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="session_id"/>
                        <field name="move_type" widget="radio" options="{'horizontal': true}"/>
                        <field name="available_reason_ids" invisible="1"/>
                        <field name="reason_id" options="{'no_create': True}"/>
                        <field name="account_id" invisible="not reason_id"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount"/>
                        <field name="note" placeholder="Optional details"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button special="cancel" string="Discard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
