<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_cash_move_line_list" model="ir.ui.view">
        <field name="name">account.bank.statement.line.pos.cash.move.list</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="pos_session_id"/>
                <field name="journal_id" optional="show"/>
                <field name="pos_cash_move_reason_id"/>
                <field name="payment_ref"/>
                <field name="move_id" optional="show"/>
                <field name="create_uid" string="Cashier" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum="Total"/>
            </list>
        </field>
    </record>

    <record id="view_pos_cash_move_line_search" model="ir.ui.view">
        <field name="name">account.bank.statement.line.pos.cash.move.search</field>
        <field name="model">account.bank.statement.line</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="payment_ref"/>
                <field name="pos_session_id"/>
                <field name="pos_cash_move_reason_id"/>
                <field name="journal_id"/>
                <filter name="filter_in" string="Cash In" domain="[('amount', '&gt;', 0)]"/>
                <filter name="filter_out" string="Cash Out" domain="[('amount', '&lt;', 0)]"/>
                <separator/>
                <filter name="filter_no_reason" string="Without Reason" domain="[('pos_cash_move_reason_id', '=', False)]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>
                <group>
                    <filter name="group_reason" string="Reason" context="{'group_by': 'pos_cash_move_reason_id'}"/>
                    <filter name="group_session" string="Session" context="{'group_by': 'pos_session_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_pos_cash_move_lines" model="ir.actions.act_window">
        <field name="name">Cash Moves</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('trx_pos_cash_move', '=', True)]</field>
        <field name="context">{'search_default_group_reason': 1}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_pos_cash_move_line_list')})]"/>
        <field name="search_view_id" ref="view_pos_cash_move_line_search"/>
    </record>

    <menuitem id="menu_pos_cash_move_lines"
              parent="point_of_sale.menu_point_rep"
              action="action_pos_cash_move_lines"
              sequence="10"
              groups="point_of_sale.group_pos_manager,account.group_account_readonly"/>
</odoo>
