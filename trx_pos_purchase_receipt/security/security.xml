<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_pos_receipt">
        <field name="name">Recepción de mercadería en el POS</field>
        <field name="sequence">57</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_pos_receipt" model="res.groups">
        <field name="name">Recibir mercadería en el POS</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_receipt"/>
        <field name="comment">Puede ver las entradas pendientes de órdenes de compra del depósito del punto de venta y recibirlas escaneando desde el POS.</field>
    </record>

    <record id="group_pos_receipt_see_expected" model="res.groups">
        <field name="name">Recibir mercadería y ver cantidades pedidas</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_receipt"/>
        <field name="implied_ids" eval="[(4, ref('group_pos_receipt'))]"/>
        <field name="comment">En los puntos de venta con recepción a ciegas, además ve las cantidades pedidas y el avance contra lo pedido.</field>
    </record>

    <record id="point_of_sale.group_pos_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_pos_receipt_see_expected'))]"/>
    </record>
</odoo>
