<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_receipt" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.trx_pos_purchase_receipt</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="inside">
                <setting id="trx_receipt_enabled" string="Recepción de mercadería"
                         help="Botón 'Recepciones' en el POS: recibir escaneando las entradas pendientes de órdenes de compra del depósito de este punto de venta.">
                    <field name="pos_trx_receipt_enabled"/>
                    <div class="mt-2" invisible="not pos_trx_receipt_enabled">
                        <field name="pos_trx_receipt_blind" class="w-auto me-2"/>
                        <label for="pos_trx_receipt_blind" string="Recepción a ciegas (sin ver lo pedido)"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
