<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_pos_receipt" model="ir.ui.view">
        <field name="name">stock.picking.form.trx_pos_purchase_receipt</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']" position="after">
                <field name="trx_pos_scanned_qty" optional="hide" readonly="1"
                       column_invisible="parent.picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
