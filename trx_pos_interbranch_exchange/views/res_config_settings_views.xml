<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ibx" model="ir.ui.view">
        <field name="name">res.config.settings.form.ibx</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_payment_section']" position="inside">
                <setting id="trx_ibx_setting" string="Cambio inter-sucursal"
                         title="Cambios de productos vendidos en otra sucursal (aun de otra compañía). La NC se emite en la compañía que vendió y la mercadería ingresa en la que recibe; la diferencia queda en una cuenta corriente entre compañías.">
                    <div class="content-group">
                        <field name="trx_ibx_is_branch" invisible="1"/>
                        <field name="trx_ibx_root_company_name" invisible="1"/>
                        <div class="alert alert-info py-1 mt8" role="status" invisible="not trx_ibx_is_branch">
                            Esta compañía es una sucursal: la configuración del cambio inter-sucursal se hereda de <field name="trx_ibx_root_company_name" class="fw-bold" readonly="1"/> y se edita allí.
                        </div>
                        <div class="row mt16">
                            <label string="Plazo máximo (días)" for="trx_ibx_days_limit" class="col-lg-5 o_light_label"/>
                            <field name="trx_ibx_days_limit" readonly="trx_ibx_is_branch"/>
                        </div>
                        <div class="row">
                            <label string="Devolver diferencia en efectivo" for="trx_ibx_allow_cash_difference" class="col-lg-5 o_light_label"/>
                            <field name="trx_ibx_allow_cash_difference" readonly="trx_ibx_is_branch"/>
                        </div>
                        <div class="row">
                            <label string="Diario NC ventas NF" for="trx_ibx_nf_journal_id" class="col-lg-5 o_light_label"/>
                            <field name="trx_ibx_nf_journal_id" readonly="trx_ibx_is_branch"/>
                        </div>
                        <div class="row">
                            <label string="Cuenta corriente" for="trx_ibx_account_id" class="col-lg-5 o_light_label"/>
                            <field name="trx_ibx_account_id" readonly="1"/>
                        </div>
                        <div class="row">
                            <label string="Medio de pago" for="trx_ibx_payment_method_id" class="col-lg-5 o_light_label"/>
                            <field name="trx_ibx_payment_method_id" readonly="1"/>
                        </div>
                        <div class="mt8">
                            <button name="action_trx_ibx_setup" type="object" string="Crear cuentas, diarios y medio de pago" class="btn-link" icon="oi-arrow-right"/>
                        </div>
                        <div class="text-muted">
                            Idempotente: crea lo que falte para esta razón social (compañía raíz) y agrega el medio de pago a todos los POS de la raíz y de sus sucursales. Repetir por cada CUIT. Las sucursales heredan la configuración de su raíz.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
