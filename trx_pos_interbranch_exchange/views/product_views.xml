<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_ibx" model="ir.ui.view">
        <field name="name">product.category.form.ibx</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="trx_ibx_exchange_ok"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_ibx" model="ir.ui.view">
        <field name="name">product.template.form.ibx</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos']" position="inside">
                <group string="Cambio inter-sucursal">
                    <field name="trx_ibx_exchange_policy"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
