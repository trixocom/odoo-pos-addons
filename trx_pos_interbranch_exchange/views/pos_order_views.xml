<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_ibx" model="ir.ui.view">
        <field name="name">pos.order.form.ibx</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_ticket_cambio" type="object" string="Ticket de cambio" class="btn-secondary" invisible="state not in ('paid', 'done', 'invoiced')"/>
            </xpath>
        </field>
    </record>
</odoo>
