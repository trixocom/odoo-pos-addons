<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_trx_ai_inbox" model="ir.ui.view">
        <field name="name">res.config.settings.form.trx.ai.inbox</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Facturas de proveedor escaneadas (IA)" name="trx_ai_inbox_block">
                    <setting string="Lectura con IA" help="API key de Anthropic y modelo usados para leer las facturas (PDF, foto o Word).">
                        <div class="row mt8">
                            <label for="trx_ai_inbox_api_key" class="col-lg-4 o_light_label"/>
                            <field name="trx_ai_inbox_api_key" password="True"/>
                        </div>
                        <div class="row">
                            <label for="trx_ai_inbox_model" class="col-lg-4 o_light_label"/>
                            <field name="trx_ai_inbox_model"/>
                        </div>
                        <div class="row">
                            <label for="trx_ai_inbox_tolerance" class="col-lg-4 o_light_label"/>
                            <field name="trx_ai_inbox_tolerance"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
